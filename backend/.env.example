DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173
# PostgreSQL (laisser vide pour utiliser SQLite en local)
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Paiement en ligne -------------------------------------------------------------------------------------
# Ne jamais mettre de vraies clés dans ce fichier ni dans git : elles vont dans backend/.env.
FRONTEND_URL=http://localhost:5173
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=XOF
# Jeko (business.jeko.africa > Paramètres > API & Webhooks). Les trois premiers sont nécessaires pour l'activer.
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=

# --- Production (voir docs/deploiement.md) ---
CSRF_TRUSTED_ORIGINS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Venolva <no-reply@venolva.app>
REDIS_URL=
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
